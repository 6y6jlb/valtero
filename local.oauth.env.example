# Local Google OAuth client ids for Valtero (DO NOT COMMIT).
# Copy to local.oauth.env and fill in the values you need:
#   cp local.oauth.env.example local.oauth.env
#
# Make / release scripts load non-empty keys as --dart-define=KEY=VALUE.
# Missing keys are fine: that platform simply won't enable Google Drive Sync.
#
# Create clients in Google Cloud Console → APIs & Services → Credentials:
#   DESKTOP  → OAuth client type "Desktop app"  (Linux / Windows)
#              copy both Client ID and Client secret
#   ANDROID  → OAuth client type "Android"
#              package: com.valtero.valtero
#              SHA-1:   make android-sha1   (debug) or make android-sha1-release …
#              Advanced settings → enable “Custom URI scheme”
#              (required; new Android clients block reverse-client-id redirects by default)
#
# Enable Google Drive API for the same project.
# Consent screen: Testing + your Google account in Test users.

# Desktop (Linux / Windows) — loopback http://127.0.0.1:43823/oauth2redirect
GOOGLE_OAUTH_CLIENT_ID_DESKTOP=
# Required for token exchange on Desktop (Google still asks for it with PKCE).
GOOGLE_OAUTH_CLIENT_SECRET_DESKTOP=

# Android — reverse-client-id redirect (com.googleusercontent.apps.<prefix>:/oauth2redirect)
# Must enable Custom URI scheme on that Android OAuth client (Advanced settings).
GOOGLE_OAUTH_CLIENT_ID_ANDROID=

# Optional legacy fallback used when a platform-specific key above is empty
# GOOGLE_OAUTH_CLIENT_ID=
